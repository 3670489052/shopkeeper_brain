# ====================
# Model Source & Cache
# ====================
# 模型来源（ModelScope）
MINERU_MODEL_SOURCE=modelscope
# ModelScope 离线模式
# MODELSCOPE_OFFLINE=1
# ModelScope 模型缓存路径
MODELSCOPE_CACHE=D:/ai_models/modelscope_cache
# Hugging Face 缓存路径
HF_HOME=D:/ai_models/huggingface_cache

# ===================== MinerU API =====================
# mineru api以及url处理地址！
MINERU_API_TOKEN=sk-wAs3Gbpc4BUUIay7Q52fz3GZQv32Xz3PdeuGmq98oYYdrSM7
MINERU_BASE_URL=https://mineru.net/api/v4

# 临时文件根目录
MD_ROOT_DIR=./temp-files/
# ====================
# OpenAI / LLM API (DashScope compatible)
# ====================
# API 密钥（兼容 OpenAI 格式）
OPEN_API_KEY=sk-dc736fa46e874f638b03317bb63e82ed
# API 基础地址（阿里云 DashScope）
OPEN_API_BASE=https://api.deepseek.com
# 默认 LLM 模型
LLM_DEFAULT_MODEL=deepseek-flash
# 默认温度参数
LLM_DEFAULT_TEMPERATURE=0.1

# VLM视觉语言模型
VL_MODEL=deepseek-flash
# 商品名识别相关模型
ITEM_MODEL=deepseek-flash
# 知识图谱模型
KG_MODEL=deepseek-flash

# ====================
# BGE Embedding Models
# ====================
# BGE-M3 模型本地路径
BGE_M3_PATH=D:\ai_models\modelscope_cache\models\BAAI\bge-m3
# BGE-M3 模型名称
BGE_M3=BAAI/bge-m3
# 嵌入模型运行设备
BGE_DEVICE=cuda:0
# 是否使用半精度
BGE_FP16=True
# BGE 重排序模型路径
BGE_RERANKER_LARGE=D:\ai_models\modelscope_cache\models\BAAI\BAAI\bge-reranker-large
# 重排序模型设备
BGE_RERANKER_DEVICE=cuda:0
# 重排序模型半精度
BGE_RERANKER_FP16=1
# 项目名称诊断标志
ITEM_NAME_DIAG=1

# ====================
# Embedding General
# ====================
# 嵌入向量维度
EMBEDDING_DIM=1536
# 嵌入模型名称
EMBEDDING_MODEL=text-embedding-v4

# ====================
# Vector Database (Milvus)
# ====================
# Milvus 连接地址
MILVUS_URL=http://192.168.144.100:19530
# 知识库集合名
CHUNKS_COLLECTION=kb_chunks_v1


# 商品名称集合名
ITEM_NAME_COLLECTION=kb_item_names_v1

# 相似度度量方式
MILVUS_METRIC_TYPE=COSINE
# 最小余弦相似度阈值
MILVUS_MIN_COSINE_SCORE=0.75



# ====================
# Document Database (MongoDB)
# ====================
